{
  "expo": {
    "name": "AR Car Showcase",
    "slug": "ar-car-showcase",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/release.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to select marker images"
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "androidXrMode": "AR"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": false
          }
        }
      ],
      "expo-router",
      "expo-web-browser",
      "expo-asset"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.adepusricharan.arcarshowcase",
      "icon": "./assets/images/release.png",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access for AR car showcase"
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "package": "com.adepusricharan.arcarshowcase",
      "icon": "./assets/images/release.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/release.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "CAMERA",
        "INTERNET"
      ],
      "versionCode": 1
    },
    "extra": {
      "API_URL": "https://oversufficient-tinley-slimming.ngrok-free.dev/api",
      "router": {
        "scheme": "arcarshowcase"
      },
      "eas": {
        "projectId": "7668994d-2dfa-44f8-954f-e7e64254375d"
      }
    }
  }
}
