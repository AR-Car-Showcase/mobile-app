{
  "expo": {
    "name": "AR Car Showcase",
    "slug": "ar-car-showcase",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/release.png",
    "scheme": "arcarshowcase",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-dev-client",
      [
        "@reactvision/react-viro",
        {
          "androidXrMode": "AR"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": false,
            "extraProguardRules": "-keep class com.facebook.hermes.unicode.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class com.viro.renderer.** { *; }\n-keep class com.viro.core.** { *; }",
            "minSdkVersion": 24
          }
        }
      ],
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.adepusricharan.arcarshowcase",
      "icon": "./assets/images/release.png",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access for AR car showcase"
      }
    },
    "android": {
      "package": "com.adepusricharan.arcarshowcase",
      "icon": "./assets/images/release.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/release.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "CAMERA",
        "INTERNET"
      ],
      "versionCode": 1,
      "enableDangerousExperimentalLeanBuilds": false,
      "splits": {
        "abi": true,
        "density": false
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "com.googleusercontent.apps.857411310572-vbjo309kjjqrk4q0lg7b2tcinnmnvd3v"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "extra": {
      "router": {
        "scheme": "arcarshowcase"
      },
      "eas": {
        "projectId": "7668994d-2dfa-44f8-954f-e7e64254375d"
      }
    }
  }
}
